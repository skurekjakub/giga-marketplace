#!/usr/bin/env bash
# PreToolUse hook matching Bash. Blocks destructive command patterns by exiting
# with code 2 (Claude Code's "deny" signal for PreToolUse). Pass-through (exit 0)
# for anything that doesn't match.
#
# Patterns blocked:
#   - rm -rf / (any variation rooted at /)
#   - git push --force / --force-with-lease (rewrites remote history)
#   - git reset --hard origin/<branch> (silently overwrites local work)
#   - git rebase -i (interactive — not supported in Claude Code)
#   - git commit --amend (per project convention, prefer new commits)
#   - git push --no-verify / commit --no-verify (skips hooks)
#   - git push / commit --no-gpg-sign (skips signing)
#
# The git rules apply only to commands that run inside this project (see
# exit_if_outside_project); rm -rf at the root is blocked everywhere.
#
# Edit or delete any match_and_block line your team doesn't want.
#
# Reads the command with jq. Without jq it fails closed-ish: the patterns are
# matched against the raw hook payload instead, which still catches every
# destructive command (at the cost of the odd false positive).

set -euo pipefail

input=$(cat)
if command -v jq >/dev/null 2>&1; then
    cmd=$(echo "$input" | jq -r '.tool_input.command // ""' 2>/dev/null || echo "")
else
    cmd="$input"
fi

# Empty command — let it through; Claude Code will handle.
if [ -z "$cmd" ]; then
    exit 0
fi

# Pattern checks. Each match emits a reason to stderr and exits 2.
match_and_block() {
    local pattern="$1"
    local reason="$2"
    if echo "$cmd" | grep -qE "$pattern"; then
        echo "blocked by project hook: ${reason}" >&2
        echo "command was: ${cmd}" >&2
        exit 2
    fi
}

match_and_block 'rm[[:space:]]+-rf[[:space:]]+/[^/a-zA-Z]' \
    "rm -rf rooted at filesystem root"
match_and_block 'rm[[:space:]]+-rf[[:space:]]+/$' \
    "rm -rf / (literal)"

# Prints nothing and exits 0 — letting the command through — when it runs in
# a directory outside $CLAUDE_PROJECT_DIR: the payload's cwd, moved by a
# leading `cd <dir> &&` / `cd <dir>;` and then by `git -C <dir>`. The rules
# below are this project's conventions, not another repo's. Best effort: with
# no jq, no project dir, or a directory that does not resolve, the command
# counts as inside and the guard applies.
exit_if_outside_project() {
    local root="${CLAUDE_PROJECT_DIR:-}" dir target here top re
    [ -n "$root" ] && command -v jq >/dev/null 2>&1 || return 0
    dir=$(printf '%s' "$input" | jq -r '.cwd // ""' 2>/dev/null || echo "")
    [ -n "$dir" ] || dir="$PWD"
    local word='("[^"]+"|'"'"'[^'"'"']+'"'"'|[^[:space:];&|]+)'
    for re in "^[[:space:]]*cd[[:space:]]+${word}[[:space:]]*(&&|;)" "git[[:space:]]+-C[[:space:]]+${word}"; do
        [[ $cmd =~ $re ]] || continue
        target="${BASH_REMATCH[1]}"
        target="${target#\"}"; target="${target%\"}"; target="${target#\'}"; target="${target%\'}"
        target="${target/#\~/$HOME}"
        case "$target" in /* | [A-Za-z]:*) dir="$target" ;; *) dir="$dir/$target" ;; esac
    done
    here=$(cd "$dir" 2>/dev/null && pwd -P) || return 0
    top=$(cd "$root" 2>/dev/null && pwd -P) || return 0
    case "$here/" in "$top"/*) return 0 ;; esac
    exit 0
}

# rm -rf at the filesystem root is checked above wherever it runs; the git
# rules are this project's and stop at its edge.
exit_if_outside_project

match_and_block 'git[[:space:]]+push.*--force' \
    "git push --force (rewrites remote history)"
match_and_block 'git[[:space:]]+push.*--force-with-lease' \
    "git push --force-with-lease (still rewrites remote)"
match_and_block 'git[[:space:]]+reset[[:space:]]+--hard[[:space:]]+origin/' \
    "git reset --hard against origin/ (silently overwrites local)"
match_and_block 'git[[:space:]]+rebase[[:space:]]+-i' \
    "git rebase -i (interactive; unsupported)"
match_and_block 'git[[:space:]]+commit.*--amend' \
    "git commit --amend (project convention prefers new commits)"
match_and_block 'git[[:space:]]+(push|commit).*--no-verify' \
    "git --no-verify (skipping hooks is project-forbidden)"
match_and_block 'git[[:space:]]+(push|commit).*--no-gpg-sign' \
    "git --no-gpg-sign (bypassing signing is project-forbidden)"

exit 0
