#!/usr/bin/env bash
# PreToolUse hook matching Bash. Steers whole-repo quality-gate runs toward the
# project's single verify command ({{VERIFY_CMD}}) by exiting 2 (Claude Code's
# "deny" signal for PreToolUse). Pass-through (exit 0) for anything else.
#
# The point is to stop the "run five gates by hand" pattern without breaking the
# tight debugging loop, so the rules are deliberately narrow:
#
#   1. Two or more gates chained in one command  -> blocked. That is verify's job.
#   2. An unscoped whole-repo run of a gate that HAS a scoped form
#      (test, lint, format check)               -> blocked. Scope it or verify.
#   3. A lone typecheck / knip / dependency-cruiser run -> allowed. No scoped
#      form exists, and each is fast enough to be a legitimate single check.
#
# Matching is anchored to the whole segment, so any extra argument — a path, a
# filter, `--` passthrough — falls through as a scoped run and is allowed.
# Add your own gate spellings to gate_of() below. A command that runs outside
# this project (see exit_if_outside_project) is never blocked.
#
# Needs jq to read the hook payload.

set -euo pipefail

VERIFY_CMD='{{VERIFY_CMD}}'

input=$(cat)
cmd=$(echo "$input" | jq -r '.tool_input.command // ""' 2>/dev/null || echo "")

if [ -z "$cmd" ]; then
    exit 0
fi

# Never block the verify command itself.
[ "$cmd" = "$VERIFY_CMD" ] && exit 0

# Prints nothing and exits 0 — letting the command through — when it runs in
# a directory outside $CLAUDE_PROJECT_DIR: the payload's cwd, moved by a
# leading `cd <dir> &&` / `cd <dir>;` and then by `git -C <dir>`. The rules
# below are this project's conventions, not another repo's. Best effort: with
# no jq, no project dir, or a directory that does not resolve, the command
# counts as inside and the guard applies.
exit_if_outside_project() {
    local root="${CLAUDE_PROJECT_DIR:-}" dir target here top re
    [ -n "$root" ] && command -v jq >/dev/null 2>&1 || return 0
    dir=$(printf '%s' "$input" | jq -r '.cwd // ""' 2>/dev/null || echo "")
    [ -n "$dir" ] || dir="$PWD"
    local word='("[^"]+"|'"'"'[^'"'"']+'"'"'|[^[:space:];&|]+)'
    for re in "^[[:space:]]*cd[[:space:]]+${word}[[:space:]]*(&&|;)" "git[[:space:]]+-C[[:space:]]+${word}"; do
        [[ $cmd =~ $re ]] || continue
        target="${BASH_REMATCH[1]}"
        target="${target#\"}"; target="${target%\"}"; target="${target#\'}"; target="${target%\'}"
        target="${target/#\~/$HOME}"
        case "$target" in /* | [A-Za-z]:*) dir="$target" ;; *) dir="$dir/$target" ;; esac
    done
    here=$(cd "$dir" 2>/dev/null && pwd -P) || return 0
    top=$(cd "$root" 2>/dev/null && pwd -P) || return 0
    case "$here/" in "$top"/*) return 0 ;; esac
    exit 0
}
exit_if_outside_project

# Classify one command segment as a gate, or empty string when it is not one.
gate_of() {
    # Output-filtering proxies (for example rtk) wrap bare dev commands, so the
    # same gate can arrive either way.
    local seg="${1#rtk }"
    case "$seg" in
    'npm run typecheck' | 'pnpm typecheck' | 'yarn typecheck' | 'npx tsc --noEmit' | 'tsc --noEmit') echo typecheck ;;
    'npm run lint' | 'pnpm lint' | 'yarn lint' | 'npx eslint .' | 'eslint .') echo lint ;;
    'npm run format:check' | 'pnpm format:check' | 'yarn format:check' | 'npx prettier --check .') echo format ;;
    'npm run knip' | 'npx knip' | 'npx knip --no-progress') echo knip ;;
    'npx depcruise src' | 'npx depcruise .') echo depcruise ;;
    'npm test' | 'npm run test' | 'pnpm test' | 'yarn test' | 'npx vitest run' | 'vitest run' | 'npx jest' | 'jest') echo test ;;
    *) echo '' ;;
    esac
}

# Split on &&, ||, ; and newlines, then collect the gates each segment names.
gates=()
while IFS= read -r segment; do
    segment="$(echo "$segment" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -z "$segment" ] && continue
    gate="$(gate_of "$segment")"
    [ -n "$gate" ] && gates+=("$gate")
done < <(echo "$cmd" | sed -e 's/&&/\n/g' -e 's/||/\n/g' -e 's/;/\n/g')

if [ "${#gates[@]}" -eq 0 ]; then
    exit 0
fi

block() {
    echo "blocked by project hook: ${1}" >&2
    echo "run: ${VERIFY_CMD}${2:+   (or ${2})}" >&2
    echo "command was: ${cmd}" >&2
    exit 2
}

if [ "${#gates[@]}" -ge 2 ]; then
    block "${#gates[@]} quality gates chained by hand (${gates[*]})"
fi

case "${gates[0]}" in
test) block "unscoped whole-repo test run" "scope it to one test file" ;;
lint | format) block "unscoped whole-repo ${gates[0]} run" "scope it by passing a path" ;;
esac

exit 0
