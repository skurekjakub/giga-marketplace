#!/usr/bin/env bash
# PreToolUse hook matching Bash. Blocks the two commands that cannot produce a
# message conforming to {{PR_GUIDE_PATH}}, by exiting 2 (Claude Code's "deny"
# signal for PreToolUse). Pass-through (exit 0) for anything else.
#
# It checks for flags, never for message content: a shell string cannot be
# re-quoted reliably here, and a hook that mis-parses a heredoc would block
# correct work. So the rules are deliberately narrow, and both fail open:
#
#   1. `git commit` carrying exactly one message flag, with no -F/--file
#      -> blocked. That shape can only produce a subject; a reviewable commit
#      needs a body saying what problem the change solves and why this way.
#   2. `gh pr create --fill` (or --fill-first / --fill-verbose / -f) -> blocked.
#      Autofilling a PR body from commit text bypasses the PR shape entirely.
#
# A multi-line command is left alone before any of that. `-m "$(cat <<'EOF' …)"`
# is the usual way of passing a real body, and it is indistinguishable from a
# bare subject once the command has been split into lines.
#
# A command that runs outside this project (see exit_if_outside_project) is
# never blocked: another repo has its own commit conventions.
#
# Needs jq to read the hook payload; without it every command passes.

set -euo pipefail

input=$(cat)
cmd=$(echo "$input" | jq -r '.tool_input.command // ""' 2>/dev/null || echo "")

if [ -z "$cmd" ]; then
    exit 0
fi

# Prints nothing and exits 0 — letting the command through — when it runs in
# a directory outside $CLAUDE_PROJECT_DIR: the payload's cwd, moved by a
# leading `cd <dir> &&` / `cd <dir>;` and then by `git -C <dir>`. Best effort:
# with no jq, no project dir, or a directory that does not resolve, the
# command counts as inside and the guard applies.
exit_if_outside_project() {
    local root="${CLAUDE_PROJECT_DIR:-}" dir target here top re
    [ -n "$root" ] && command -v jq >/dev/null 2>&1 || return 0
    dir=$(printf '%s' "$input" | jq -r '.cwd // ""' 2>/dev/null || echo "")
    [ -n "$dir" ] || dir="$PWD"
    local word='("[^"]+"|'"'"'[^'"'"']+'"'"'|[^[:space:];&|]+)'
    for re in "^[[:space:]]*cd[[:space:]]+${word}[[:space:]]*(&&|;)" "git[[:space:]]+-C[[:space:]]+${word}"; do
        [[ $cmd =~ $re ]] || continue
        target="${BASH_REMATCH[1]}"
        target="${target#\"}"; target="${target%\"}"; target="${target#\'}"; target="${target%\'}"
        target="${target/#\~/$HOME}"
        case "$target" in /* | [A-Za-z]:*) dir="$target" ;; *) dir="$dir/$target" ;; esac
    done
    here=$(cd "$dir" 2>/dev/null && pwd -P) || return 0
    top=$(cd "$root" 2>/dev/null && pwd -P) || return 0
    case "$here/" in "$top"/*) return 0 ;; esac
    exit 0
}
exit_if_outside_project

advise() {
    echo "blocked by project hook: ${1}" >&2
    echo "" >&2
    echo "${2}" >&2
    echo "" >&2
    echo "format: {{PR_GUIDE_PATH}}" >&2
    echo "command was: ${cmd}" >&2
    exit 2
}

multiline=0
case "$cmd" in
*$'\n'*) multiline=1 ;;
esac

# Each segment is examined on its own, so a git commit chained behind a build
# still gets checked. Output-filtering proxies (for example rtk) wrap bare dev
# commands, so their prefix is stripped first.
while IFS= read -r segment; do
    segment="$(echo "$segment" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    segment="${segment#rtk }"
    [ -z "$segment" ] && continue

    case "$segment" in
    'git commit'* | 'git '*' commit'*)
        [ "$multiline" -eq 1 ] && continue

        # A body can arrive from a file or from stdin; either satisfies the format.
        case "$segment" in
        *' -F'* | *'--file'*) continue ;;
        esac

        # Combined short flags (-am) and both spellings of the long form count.
        messages=$(echo "$segment" |
            grep -oE '(^| )-[a-zA-Z]*m( |=|$)|(^| )--message( |=|$)' | wc -l || true)
        [ "${messages:-0}" -eq 1 ] || continue

        advise \
            "git commit with a subject and no body" \
            "A single -m can only produce a subject line. The body owes the problem this
change solves and why this solution over the alternatives — a reader must be
able to judge the change without the diff.

Write the message to a file and pass -F, or pass -m once per paragraph."
        ;;
    'gh pr create'*)
        case "$segment" in
        *' --fill'* | *' -f '* | *' -f')
            advise \
                "gh pr create autofilling its body from commits" \
                "--fill copies commit text into the PR body. A PR body is a different
document with its own sections, including the one a reviewer needs most: what
the review should challenge.

Write the body to a file and pass --body-file." ;;
        esac
        ;;
    esac
done < <(echo "$cmd" | sed -e 's/&&/\n/g' -e 's/||/\n/g' -e 's/;/\n/g')

exit 0
