#!/usr/bin/env bash
# Stop hook — fires when Claude finishes its overall response. Pings a desktop
# notification so you don't have to keep the terminal in focus.
#
#   Linux:   notify-send. Suppressed when the focused window is a terminal or an
#            editor with an integrated terminal (needs xdotool + xprop on X11 or
#            XWayland; without them it always notifies — better to over-notify
#            than miss the ping).
#   macOS:   osascript "display notification".
#   Windows: a PowerShell balloon tip (Git Bash runs this hook).
#
# Never blocks and never fails the turn: every branch ends in `|| true`.

set -euo pipefail

TITLE="Claude Code"
MESSAGE="done"

notify_linux() {
    local should_notify=true
    if command -v xdotool >/dev/null 2>&1 && command -v xprop >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        local win_id active_class=""
        win_id=$(xdotool getactivewindow 2>/dev/null || echo "")
        if [ -n "$win_id" ]; then
            # WM_CLASS(STRING) = "instance", "Class" — take the last quoted token (the class).
            active_class=$(xprop -id "$win_id" WM_CLASS 2>/dev/null | sed -n 's/.*"\([^"]*\)"$/\1/p')
        fi
        case "$active_class" in
            Gnome-terminal|gnome-terminal|kitty|Kitty|Alacritty|alacritty|Konsole|konsole|XTerm|xterm|UXTerm|st|St|Terminator|terminator|Tilix|tilix|WezTerm|wezterm|Foot|foot|Ghostty|ghostty|Hyper|hyper)
                should_notify=false ;;
            Code|code|Code-Insiders|code-insiders|VSCodium|vscodium|Cursor|cursor|Windsurf|windsurf|jetbrains-*)
                should_notify=false ;;
        esac
    fi
    if [ "$should_notify" = "true" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send "$TITLE" "$MESSAGE" --urgency=low --expire-time=3000 2>/dev/null || true
    fi
}

notify_macos() {
    osascript -e "display notification \"${MESSAGE}\" with title \"${TITLE}\"" >/dev/null 2>&1 || true
}

notify_windows() {
    command -v powershell.exe >/dev/null 2>&1 || return 0
    powershell.exe -NoProfile -NonInteractive -Command "
        Add-Type -AssemblyName System.Windows.Forms, System.Drawing
        \$n = New-Object System.Windows.Forms.NotifyIcon
        \$n.Icon = [System.Drawing.SystemIcons]::Information
        \$n.Visible = \$true
        \$n.ShowBalloonTip(3000, '${TITLE}', '${MESSAGE}', 'Info')
        Start-Sleep -Seconds 4
        \$n.Dispose()
    " >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

case "$(uname -s 2>/dev/null || echo unknown)" in
    Linux*) notify_linux ;;
    Darwin*) notify_macos ;;
    MINGW*|MSYS*|CYGWIN*) notify_windows ;;
esac

exit 0
