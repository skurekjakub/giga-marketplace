{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/workspace.mjs", "session-check"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
