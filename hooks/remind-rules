#!/usr/bin/env bash
# Injects a short, periodic reminder of the project's highest-priority
# code-quality rules. Wired on UserPromptSubmit and on PostToolUse for the tools
# the rules govern; emits at most once per REMIND_INTERVAL_SECONDS (default 360)
# so the rules stay live inside long autonomous turns without flooding context.
#
# Customize per repo: edit the REMINDERS array below. Keep entries terse — a
# single line each, prioritized by impact. The goal is one-glance reinforcement,
# not paragraphs of doctrine. Three to five rules max; more becomes noise.
#
# Output: JSON with hookSpecificOutput.additionalContext (Claude Code shape).
# Falls back to `additionalContext` top-level for compatible platforms.

set -euo pipefail

# The event name decides which output key Claude Code reads; a payload without
# one is treated as a user prompt.
payload=$(cat 2>/dev/null || true)
event=$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)
[ -n "$event" ] || event="UserPromptSubmit"

# Throttle on wall clock, not turn count: a single autonomous turn can run for
# many minutes of tool calls without a UserPromptSubmit ever firing.
# State is the last emit timestamp, per-repo (keyed by cwd) so concurrent repos
# throttle independently.
REMIND_INTERVAL_SECONDS="${REMIND_INTERVAL_SECONDS:-360}"
state_dir="${HOME}/.claude"
state_file="${state_dir}/.remind-rules-last-$(printf '%s' "$PWD" | cksum | cut -d' ' -f1)"
mkdir -p "$state_dir"
now=$(date +%s)
last=$(cat "$state_file" 2>/dev/null || echo 0)
case "$last" in ''|*[!0-9]*) last=0 ;; esac
if [ $((now - last)) -lt "$REMIND_INTERVAL_SECONDS" ]; then
    exit 0
fi
printf '%s' "$now" > "$state_file"

REMINDERS=(
    "COMMENTS READ AS API, NOT NARRATIVE — JSDoc on every function (what it does, params, returns, how it fails), plus two-line inline comments at gotchas. Test each sentence: would it still be true if a different caller used this tomorrow? If not, cut it — no flow tracing, no caller lists, no facts about today's data. Why you chose it goes in the commit message; a behaviour that must keep working goes in a test name; history stays in git log."
    "NEVER MANUALLY TRUNCATE COMMAND OUTPUT — no head/tail/grep piping on test/build/run; run bare. Exception: rtk's own filtered proxies (rtk vitest/tsc/lint/test/git) are sanctioned — the user opted into rtk's failure-focused compaction for token savings."
    "UNRELATED CODE — don't touch code outside the task. Surface bad code or design smells you spot; the user decides whether to address separately."
)

# Build the reminder block.
reminder_text="HIGH-PRIORITY RULES (auto-injected periodically — fix in .claude/hooks/remind-rules if outdated):"
for r in "${REMINDERS[@]}"; do
    reminder_text="${reminder_text}
- ${r}"
done

# Caveman mode reinforcement — the caveman plugin writes the active intensity to
# this user-scoped flag. Mirror it here so the reminder survives long turns where
# other injected context crowds the plugin's own per-turn line out of attention.
caveman_mode=$(cat "${HOME}/.claude/.caveman-active" 2>/dev/null || true)
if [ -n "$caveman_mode" ]; then
    reminder_text="${reminder_text}
- CAVEMAN MODE ACTIVE (${caveman_mode}) — stay compressed: drop articles/filler/pleasantries/hedging. Fragments OK. Code/commits/security: write normal."
fi

# Bash parameter-substitution JSON-escaper (matches the pattern in project-context).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

reminder_escaped=$(escape_for_json "$reminder_text")

# Claude Code reads nested hookSpecificOutput and drops the block unless
# hookEventName matches the firing event; Cursor reads a flat top-level key.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$reminder_escaped"
else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$reminder_escaped"
fi

exit 0
